extends ../layout/index

block contenido 
  div.py-10.bg-mati2
    h2.text-4xl.my-10.font-extrabold.text-center.text-mati3 Bienes 
      span.font-normal.text-mati4 Raices 
    h2.text-center.text-2xl.font-extrabold.text-mati1= pagina 
      if errores
      div.mx-auto.my-10.max-w-md
        each error in errores
          div.alert(
            class="flex items-center p-4 mb-4 text-sm text-blue-800 rounded-lg bg-blue-50 border border-blue-300 dark:bg-gray-800 dark:text-blue-400 dark:border-gray-600" 
            role="alert"
          )
            svg(
              class="flex-shrink-0 inline w-5 h-5 mr-3" 
              aria-hidden="true" 
              xmlns="http://www.w3.org/2000/svg" 
              fill="currentColor" 
              viewBox="0 0 20 20"
            )
              path(d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 1 1 1 1v4h1a1 1 0 0 1 0 2Z")
            div
              span.font-medium ¡Error!: 
              | #{error.msg}
    .mt-8.mx-auto.max-w-md
      .bg-mati2.py-8.px-4.shadow
        form(method="POST" noValidate).space-y-5.px-6
          input(type="hidden" name="_csrf" value= csrfToken)
          div 
            label.block.text-sm.text-mati1.mb-2.font-bold Contraseña nueva :
            input#email.w-full.px-3.py-2.border.border-gray-300.rounded-xl.placeholder-gray-400(type="email" placeholder="mínimo 8 caracteres"  name="contra_usuario")
          .flex.items-center.justify-between
          div 
            label.block.text-sm.text-mati1.mb-2.font-bold Confirmacion la contraseña:
            input#email.w-full.px-3.py-2.border.border-gray-300.rounded-xl.placeholder-gray-400(type="email" placeholder="mínimo 8 caracteres" name="contranew_usuario")
          .flex.items-center.justify-between
          input(class="w-full bg-mati3 hover:bg-mati4 text-mati2 font-bold py-3 cursor-pointer" type="submit" value="Guardar contraseña")
  // Script para ocultar las alertas automáticamente
  script.
    document.addEventListener('DOMContentLoaded', () => {
      const alerts = document.querySelectorAll('.alert');
      setTimeout(() => {
        alerts.forEach(alert => alert.remove());
      }, 8000);
    });